{
    "name": "rooberthh/php-package-starter",
    "description": "A php package base.",
    "type": "library",
    "keywords": [
        "php",
        "package"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Roberth Evaldsson",
            "email": "evaldsson.roberth@gmail.com",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/rooberthh/php-package-starter/issues"
    },
    "funding": [],
    "require": {
        "php": "^8.5"
    },
    "require-dev": {
        "laravel/pint": "^1.25",
        "pestphp/pest": "^5.0",
        "phpstan/phpstan": "^2.1",
        "rector/rector": "^2.4"
    },
    "suggest": {},
    "autoload": {
        "psr-4": {
            "Rooberthh\\PackageStarter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rooberthh\\PackageStarter\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "test": [
            "./vendor/bin/pest"
        ],
        "pint": [
            "./vendor/bin/pint"
        ],
        "stan": [
            "./vendor/bin/phpstan analyse --memory-limit=3g"
        ],
        "rector": [
            "./vendor/bin/rector process"
        ],
        "rector:check": [
            "./vendor/bin/rector process --dry-run"
        ],
        "lint": [
            "@rector",
            "@pint",
            "@stan"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the Pest test suite.",
        "pint": "Run Laravel Pint on the codebase.",
        "stan": "Run PhpStan on the codebase.",
        "rector": "Run Rector refactorings on the codebase.",
        "rector:check": "Show Rector changes without applying them.",
        "lint": "Run Rector, Pint and PhpStan on the codebase."
    }
}
